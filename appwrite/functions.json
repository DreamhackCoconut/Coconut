[
  {
    "$id": "coconut-api",
    "name": "Coconut API",
    "enabled": true,
    "logging": true,
    "runtime": "node-22",
    "buildSpecification": "s-2vcpu-2gb",
    "runtimeSpecification": "s-0.5vcpu-512mb",
    "deploymentRetention": 7,
    "scopes": [],
    "events": [],
    "schedule": "",
    "timeout": 30,
    "entrypoint": "dist/main.js",
    "commands": "npm install && npm run build:functions",
    "ignore": "node_modules\n.next\n.tmp\n.env\ncoverage",
    "path": "..",
    "execute": ["any"]
  },
  {
    "$id": "coconut-optimizer",
    "name": "Coconut OR-Tools Optimizer",
    "enabled": true,
    "logging": true,
    "runtime": "python-3.12",
    "buildSpecification": "s-2vcpu-2gb",
    "runtimeSpecification": "s-0.5vcpu-512mb",
    "deploymentRetention": 7,
    "scopes": [],
    "events": [],
    "schedule": "",
    "timeout": 10,
    "entrypoint": "src/main.py",
    "commands": "pip install -r requirements.txt",
    "ignore": "__pycache__\n.pytest_cache\n.env",
    "path": "../functions/coconut-optimizer",
    "execute": ["any"]
  }
]
